  <ItemName>k__BackingField: Dictaphone
  <ItemDescription>k__BackingField: "\u041F\u0440\u043E\u0432\u0435\u0440\u043E\u0447\u043D\u044B\u0439
    \u0447\u0435\u043A-\u043B\u0438\u0441\u0442 (\u043D\u0430 \u0432\u0441\u044F\u043A\u0438\u0439
    \u0441\u043B\u0443\u0447\u0430\u0439):\n\u0423\u0431\u0435\u0434\u0438\u0441\u044C,
    \u0447\u0442\u043E \u043D\u0430 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u043C
    TextInfoPanel \u0432 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0435
    Content Size Fitter \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430 Horizontal
    Fit \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 Unconstrained. \u0415\u0441\u043B\u0438
    \u0442\u0430\u043C \u0431\u0443\u0434\u0435\u0442 \u0441\u0442\u043E\u044F\u0442\u044C
    Preferred Size, \u0442\u043E \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440
    \u0431\u0443\u0434\u0435\u0442 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E
    \u0440\u0430\u0441\u0442\u044F\u0433\u0438\u0432\u0430\u0442\u044C\u0441\u044F
    \u0432 \u0448\u0438\u0440\u0438\u043D\u0443 \u0432\u0441\u043B\u0435\u0434 \u0437\u0430
    \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u0442\u0435\u043A\u0441\u0442\u043E\u043C!\n\n\u0421\u0434\u0435\u043B\u0430\u0439
    \u0448\u0438\u0440\u0438\u043D\u0443 TextInfoPanel \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, 500) \u0438 \u0432\u043A\u043B\u044E\u0447\u0438
    Wrapping. \u0422\u0435\u043A\u0441\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
    \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0432 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0443\u0437\u043A\u0438\u0439
    \u0441\u0442\u043E\u043B\u0431\u0438\u043A \u043F\u043E \u0446\u0435\u043D\u0442\u0440\u0443
    \u044D\u043A\u0440\u0430\u043D\u0430!"
